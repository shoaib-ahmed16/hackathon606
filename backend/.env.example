# Connection to the FogOps database (schemas fogops + hist, built by fogops_db/rebuild.sh)
FOGOPS_DSN=postgresql://postgres:postgres@localhost:5433/fogops
# app_user id used for fogops.set_actor() when a request has no X-User-Id header
DEFAULT_ACTOR_ID=1
# Comma separated browser origins allowed to call this API directly
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ask: leave unset and only the predefined questions work. The key stays on the server (never in the browser).
# ANTHROPIC_API_KEY=sk-ant-...
# ASK_MODEL=claude-opus-5-5
# Login
AUTH_SECRET=dev-only-change-me
DEMO_PASSWORD=FogOps@2026

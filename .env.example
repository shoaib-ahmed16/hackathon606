# Copy to .env on the server:  cp .env.example .env   then change the values.
# Use letters and digits only in DB_PASSWORD (it goes inside a connection URL).
DB_PASSWORD=ChangeMe123
# Signs login tokens. Any long random string:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string
# Initial password of the demo users (occ.dm, dispatch.1, crew.ctl.1, recovery.1, admin)
DEMO_PASSWORD=FogOps@2026

# Optional: Claude API key for free-text questions in "Ask". Without it, the suggested questions still work (answered from the database).
# ANTHROPIC_API_KEY=sk-ant-...
# ASK_MODEL=claude-haiku-5-5      # cheapest; bigger models cost much more
# ASK_MAX_TOKENS=400  ASK_RATE_PER_MIN=6  ASK_DAILY_LIMIT=150
